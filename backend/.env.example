# EventVault Environment Configuration
# Copy to .env and fill in your values

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eventvault
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE-ME

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE-ME

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AWS (for managed S3 bucket provisioning)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Dropbox OAuth App (https://www.dropbox.com/developers/apps)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# App
BASE_URL=http://localhost:8000
DEBUG=true
